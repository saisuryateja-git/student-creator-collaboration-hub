<header class="topbar"><div class="nav-inner"><a class="brand" href="${pageContext.request.contextPath}/home">Creator<span>Hub</span></a><nav><a href="${pageContext.request.contextPath}/home">Home</a><a href="${pageContext.request.contextPath}/discover">Discover</a><a href="${pageContext.request.contextPath}/challenges">Challenges</a><%if(session.getAttribute("studentId")!=null){%><a href="${pageContext.request.contextPath}/create">Create</a><a href="${pageContext.request.contextPath}/dashboard">Dashboard</a><a href="${pageContext.request.contextPath}/profile">Profile</a><a class="nav-login" href="${pageContext.request.contextPath}/logout">Logout</a><%}else{%><a class="nav-login" href="${pageContext.request.contextPath}/">Login</a><%}%></nav></div></header><%if(request.getParameter("message")!=null){%><div class="page-alert success"><%=request.getParameter("message")%></div><%}%><%if(request.getParameter("error")!=null){%><div class="page-alert error"><%=request.getParameter("error")%></div><%}%>
