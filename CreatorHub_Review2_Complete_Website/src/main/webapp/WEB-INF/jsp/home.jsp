<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ page import="java.util.*" %><%@ page import="com.creatorhub.model.Collaboration" %><!doctype html><html><head><meta charset="UTF-8"><title>CreatorHub Home</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@include file="header.jspf"%><section class="hero"><div><p class="eyebrow">STUDENT CREATOR COMMUNITY</p><h1>Find Your <span>Creative Collaborator</span></h1><p>Discover talented students, work together on creative projects, showcase your work and take part in exciting challenges.</p><div class="actions"><a class="btn primary" href="${pageContext.request.contextPath}/discover">Explore Collaborations</a><a class="btn secondary" href="${pageContext.request.contextPath}/challenges">Explore Challenges</a></div></div><div class="hero-card"><b>01</b> Discover<hr><b>02</b> Collaborate<hr><b>03</b> Showcase</div></section><main class="container"><section class="section"><div class="section-head"><div><p class="eyebrow">COMMUNITY</p><h2>🔥 Trending Collaborations</h2></div><a href="${pageContext.request.contextPath}/discover">View All</a></div><div class="card-grid"><%List<Collaboration> list=(List<Collaboration>)request.getAttribute("trending");if(list!=null&&!list.isEmpty()){for(Collaboration c:list){%><article class="card"><div class="card-top"><span class="tag"><%=c.getCategory()%></span><span class="votes">▲ <%=c.getVoteCount()%></span></div><h3><%=c.getTitle()%></h3><p><%=c.getDescription()%></p><div class="meta">Need: <b><%=c.getRequiredRole()%></b></div><div class="creator">Created by <b><%=c.getCreatorName()%></b></div><a class="text-link" href="${pageContext.request.contextPath}/discover">View opportunity →</a></article><%}}else{%><div class="empty">No collaborations yet.</div><%}%></div></section><section class="section"><div class="section-head"><div><p class="eyebrow">LEADERBOARD</p><h2>Top Campus Creators</h2></div><a href="${pageContext.request.contextPath}/dashboard">View ranking →</a></div><style>
.leaderboard-wrap{display:grid;grid-template-columns:1.2fr 1fr;gap:20px;align-items:stretch}
.leaderboard-panel,.leaderboard-side{background:#fff;border:1px solid #e7eaf3;border-radius:22px;box-shadow:0 18px 40px rgba(90,90,130,.06)}
.leaderboard-panel{padding:14px 18px}
.leader-row{display:grid;grid-template-columns:52px 1fr auto;align-items:center;gap:16px;padding:14px 10px;border-bottom:1px solid #edf0f7}
.leader-row:last-child{border-bottom:none}
.rank-pill{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:12px;background:#efeaff;color:#4b46b4;font-weight:800}
.leader-meta{display:flex;flex-direction:column;gap:3px}
.leader-name{font-size:18px;font-weight:800;color:#232641}
.leader-skill{font-size:13px;color:#5d627d}
.leader-score{font-weight:800;color:#4b46b4;background:#f1efff;border-radius:10px;padding:8px 12px}
.leaderboard-side{padding:18px 20px;display:flex;flex-direction:column;justify-content:center}
.leaderboard-side h3{margin:0 0 16px;font-size:18px;color:#21253d}
.leaderboard-side .mini{display:flex;justify-content:space-between;align-items:center;padding:12px 0;border-bottom:1px solid #eef0f5}
.leaderboard-side .mini:last-child{border-bottom:none}
.leaderboard-side .mini span{color:#58607a;font-weight:700}
.leaderboard-side .mini b{color:#2d3152}
@media (max-width: 900px){.leaderboard-wrap{grid-template-columns:1fr}}
</style><div class="leaderboard-wrap"><div class="leaderboard-panel"><div class="leader-row"><span class="rank-pill">#1</span><div class="leader-meta"><span class="leader-name">AKKALA SAI SURYA TEJA GOUD</span><span class="leader-skill">Podcast Editor · 17 collaborations</span></div><span class="leader-score">980 pts</span></div><div class="leader-row"><span class="rank-pill">#2</span><div class="leader-meta"><span class="leader-name">Sangeeth</span><span class="leader-skill">Video Editor · 14 collaborations</span></div><span class="leader-score">932 pts</span></div><div class="leader-row"><span class="rank-pill">#3</span><div class="leader-meta"><span class="leader-name">Ananya</span><span class="leader-skill">Photo Editor · 11 collaborations</span></div><span class="leader-score">901 pts</span></div></div><div class="leaderboard-side"><h3>This week</h3><div class="mini"><span>Most votes</span><b>AKKALA</b></div><div class="mini"><span>Challenges won</span><b>12</b></div><div class="mini"><span>New projects</span><b>27</b></div><div class="mini"><span>Community reach</span><b>94%</b></div></div></div></section><section class="feature-band"><div><p class="eyebrow">WHY CREATORHUB?</p><h2>One place for campus creators.</h2><p>Build a profile, find collaborators, validate ideas through community votes and participate in challenges.</p></div><div class="feature-list"><div><b>Discover</b><span>Find projects by category.</span></div><div><b>Collaborate</b><span>Apply with a short pitch.</span></div><div><b>Showcase</b><span>Build your creator profile.</span></div><div><b>Challenge</b><span>Join campus competitions.</span></div></div></section></main><%@include file="footer.jspf"%></body></html>
