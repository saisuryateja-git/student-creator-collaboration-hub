<%@ page import="com.creatorhub.model.Student" %><!doctype html><html><head><title>Profile | CreatorHub</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/style.css"></head><body><%@include file="header.jspf"%><%Student s=(Student)request.getAttribute("student");%><main class="container page"><div class="profile-head"><div class="avatar"><%=s.getName().substring(0,1)%></div><div><p class="eyebrow">CREATOR PROFILE</p><h1><%=s.getName()%></h1><p class="muted"><%=s.getEmail()%></p></div></div><div class="profile-grid"><section class="panel"><p class="eyebrow">ABOUT</p><h2><%=s.getRoleTitle()%></h2><p><%=s.getAboutMe()%></p><h3>Skills</h3><div class="skills"><%for(String x:(s.getSkills()==null?"":s.getSkills()).split(",")){if(!x.trim().isEmpty()){%><span><%=x.trim()%></span><%}}%></div><h3>My Work</h3><p><%=s.getWorkText()%></p></section><section class="panel"><h2>Edit Profile</h2><form action="${pageContext.request.contextPath}/profile" method="post" class="form"><label>Creator Role</label><input name="roleTitle" value="<%=s.getRoleTitle()%>" required><label>About Me</label><textarea name="aboutMe" rows="4"><%=s.getAboutMe()%></textarea><label>Skills (comma separated)</label><input name="skills" value="<%=s.getSkills()%>"><label>Previous Work</label><textarea name="workText" rows="5"><%=s.getWorkText()%></textarea><button class="btn primary">Save Profile</button></form></section></div></main><%@include file="footer.jspf"%></body></html>
